# Leave paths empty to let Selenium find Chrome and its matching driver.
CHROME_BINARY=
CHROMEDRIVER_PATH=

# Set false only when you need to inspect the browser or handle verification.
CRAWLER_HEADLESS=true
CRAWLER_WAIT_SECONDS=30
CRAWLER_DELAY_MIN=2
CRAWLER_DELAY_MAX=4

# Local MySQL. Fill real credentials in .env only.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=MYSQL_USER_PLACEHOLDER
MYSQL_PASSWORD=PASSWORD_PLACEHOLDER
MYSQL_DATABASE=bilibili_analysis

# VM NameNode HTTP endpoint; leave blank until HDFS is connected.
HDFS_WEBHDFS_URL=
HDFS_USER=
HDFS_DATA_DIR=/bilibili-analysis/processed
SPARK_JAVA_HOME=JAVA_17_HOME_PLACEHOLDER
# Windows 中文项目路径使用纯英文目录的 Spark 目录联接，见 README。
# SPARK_HOME=SPARK_HOME_PLACEHOLDER
MYSQL_JDBC_JAR=

# 本机 Ollama 服务；模型目录通过 Windows 用户变量 OLLAMA_MODELS 设置。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_EMBED_MODEL=bge-m3
